{
  "cleanUrls": true,
  "functions": { "api/ask.js": { "maxDuration": 60 } },
  "headers": [
    {
      "source": "/data.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
